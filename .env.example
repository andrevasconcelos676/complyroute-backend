# ── App ────────────────────────────────────────────────────
APP_NAME=ComplyRoute
APP_VERSION=1.0.0
APP_ENV=development                     # development | staging | production
DEBUG=true
SECRET_KEY=TROQUE-POR-UMA-CHAVE-FORTE-256bits
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database (Neon PostgreSQL) ─────────────────────────────
# Obtenha em: https://console.neon.tech → Connection string
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/complyroute?sslmode=require
DATABASE_URL_SYNC=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/complyroute?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis (cache + filas Celery) ───────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT ────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Webhook Signing ────────────────────────────────────────
WEBHOOK_SECRET=TROQUE-POR-CHAVE-HMAC-FORTE

# ── Antifraude ─────────────────────────────────────────────
FRAUD_SCORE_MIN_AUTO_APPROVE=70
FRAUD_SCORE_MIN_MANUAL_REVIEW=50

# ── Limites Operacionais ───────────────────────────────────
TXN_MIN_AMOUNT=100            # R$ 1,00 em centavos
TXN_MAX_AMOUNT=5000000        # R$ 50.000,00 em centavos
TXN_MAX_INSTALLMENTS=18
TXN_TIMEOUT_MS=5000
TXN_MAX_RETRIES=3

# ── Subadquirentes ─────────────────────────────────────────
# Cielo
CIELO_MERCHANT_ID=
CIELO_MERCHANT_KEY=
CIELO_API_URL=https://api.cieloecommerce.cielo.com.br

# Rede
REDE_PV=
REDE_TOKEN=
REDE_API_URL=https://api.userede.com.br

# Stone
STONE_CLIENT_ID=
STONE_CLIENT_SECRET=
STONE_API_URL=https://api.openbank.stone.com.br

# PagSeguro
PAGSEGURO_TOKEN=
PAGSEGURO_API_URL=https://api.pagseguro.com

# GetNet
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
GETNET_API_URL=https://api.getnet.com.br

# SafraPay
SAFRAPAY_API_KEY=
SAFRAPAY_API_URL=https://api.safrapay.com.br

# Zoop
ZOOP_MARKETPLACE_ID=
ZOOP_API_KEY=
ZOOP_API_URL=https://api.zoop.ws

# Asaas
ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3

# OrendaPay
ORENDAPAY_CLIENT_ID=
ORENDAPAY_CLIENT_SECRET=
ORENDAPAY_API_URL=https://api.orendapay.com.br

# ── Observability ──────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
